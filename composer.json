{
    "name": "johnrivera7/filament-transbank-webpay",
    "description": "Filament plugin for Transbank Webpay Plus (Chile) — credentials UI, logos, create/commit/refund helpers.",
    "keywords": [
        "filament",
        "filament-plugin",
        "laravel",
        "transbank",
        "webpay",
        "webpay-plus",
        "payments",
        "chile"
    ],
    "homepage": "https://github.com/Johnrivera7/filament-transbank-webpay",
    "license": "MIT",
    "authors": [
        {
            "name": "John Rivera",
            "email": "johnriveragonzalez7@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0|^5.0",
        "illuminate/contracts": "^11.28|^12.0",
        "spatie/laravel-package-tools": "^1.16",
        "transbank/transbank-sdk": "^5.1"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "JohnRivera7\\FilamentTransbankWebpay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JohnRivera7\\FilamentTransbankWebpay\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JohnRivera7\\FilamentTransbankWebpay\\FilamentTransbankWebpayServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "pint": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
